# ==============================================================================
# Pentaract Faster — Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVICE VARIABLES (Configured in Railway)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
SECRET_KEY=change_this_to_a_secure_32_character_random_string
CHUNK_SIZE_MB=5
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------------------------
# 2. OPTIONAL APPLICATION VARIABLES (Defaults are already built-in)
# ------------------------------------------------------------------------------
SUPERUSER_EMAIL=admin@pentaract.local
SUPERUSER_PASS=admin123
ACCESS_TOKEN_EXPIRE_IN_SECS=2592000
REFRESH_TOKEN_EXPIRE_IN_DAYS=60
CHANNEL_CAPACITY=1000
WORKERS=2
VITE_API_BASE=/api
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. LEGACY / NOT REQUIRED IN THIS CONTAINER (Leave empty or delete in Railway)
# ------------------------------------------------------------------------------
# These are only from legacy template definitions (external PostgreSQL / MTProto).
# Pentaract Faster runs fully self-contained with Bot API and does NOT require these.
DATABASE_HOST=
DATABASE_NAME=
DATABASE_PASSWORD=
DATABASE_PORT=
DATABASE_USER=
TELEGRAM_API_BASE_URL=
TELEGRAM_API_HASH=
TELEGRAM_API_ID=
